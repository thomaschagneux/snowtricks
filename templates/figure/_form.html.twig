{% extends 'base.html.twig' %}

{% block title %}Ajout/modification d'une Figure{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-body">

            {% if figure is defined %}
                {% if app.user %}
                    {% if figure.featuredMedia is defined and not null %}
                        <div class="position-absolute px-2 py-1 m-4 z-1 border border-black bg-light top-0 end-0 d-flex align-items-center">

                            <a href="{{ path('app_media_edit', {'id': figure.featuredMedia.id}) }}" class="text-decoration-none me-2">
                                <i class="fa-solid fa-pen"></i>
                            </a>
                            <div class="col col-12 col-md-1 p-0 m-auto">
                                <form method="post" action="{{ path('app_media_delete', {'id': figure.featuredMedia.id}) }}">
                                    <input type="hidden" name="_method" value="DELETE">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ figure.featuredMedia.id) }}">
                                    <button type="submit" class="bg-transparent border-0"><i class="fa-solid fa-trash text-danger"></i></button>
                                </form>
                            </div>

                            <div class="modal fade" id="modal-figure-{{ figure.slug }}" tabindex="-1" aria-labelledby="modal-figure-{{ figure.slug }}" aria-hidden="true">
                                <div class="modal-dialog">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h1 class="modal-title fs-5" id="modal-figure-{{ figure.slug }}">Êtes-vous sûr de vouloir supprimer la figure {{ figure.name }}?</h1>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>

                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            <form method="post" action="{{ path('app_figure_delete', {'slug': figure.slug}) }}">
                                                <input type="hidden" name="_method" value="DELETE">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ figure.slug) }}">
                                                <button type="submit" class="btn btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    {% endif %}
                {% endif %}

                <div id="featured-section" class="featured-section position-relative text-white text-center mb-3">

                    {% if featuredImage is defined and not null %}
                        <div class="container-fluid p-0">
                            <div class="ratio ratio-16x9">
                                <img src="{{ asset(featuredImage) }}" alt="{{ figure.name }}" class="object-fit-cover">
                            </div>
                        </div>
                    {% endif %}

                    <div class="container position-absolute top-50 start-50 translate-middle text-white">
                        <h1 class="fw-bold">{{ figure.name }}</h1>
                    </div>
                </div>

                <div class="media-section mb-3">
                    <button class="btn btn-primary d-block d-md-block d-lg-none w-100 mb-3" type="button" id="toggle-medias">
                        Afficher/Masquer les médias
                    </button>

                    <div class="d-none d-md-none d-lg-block" id="medias-container">
                        <div class="row g-3">
                            {% if medias is defined and medias is not empty %}
                                {% for media in medias %}
                                    <div class="col col-12 col-md-12 col-lg-2">
                                        <div class="media-item h-95">
                                            {% if media.category == 'image' %}
                                                <img src="{{ asset(media.link) }}" alt="Image" class="w-100 h-100 object-fit-cover">
                                            {% elseif media.category == 'video' %}
                                                {% if media.isExternal %}
                                                    <div class="ratio ratio-16x9">
                                                        <iframe src="{{ media.link }}" title="Vidéo externe"
                                                                frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                                                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen>
                                                        </iframe>
                                                    </div>
                                                {% else %}
                                                    <video controls class="w-100">
                                                        <source src="{{ asset(media.link) }}" type="{{ media.mimeType }}">
                                                        Votre navigateur ne supporte pas la lecture de vidéos.
                                                    </video>
                                                {% endif %}
                                            {% elseif media.category == 'audio' %}
                                                <audio controls class="w-100">
                                                    <source src="{{ media.link }}" type="{{ media.mimeType }}">
                                                    Votre navigateur ne supporte pas la lecture audio.
                                                </audio>
                                            {% else %}
                                                <p>Type de média non supporté</p>
                                            {% endif %}
                                        </div>
                                        <div class="media-links d-flex justify-content-end gap-2">
                                            <a href="{{ path('app_media_edit', { 'id': media.id }) }}"><i class="fa-solid fa-pen"></i></a>
                                            <form method="post" action="{{ path('app_media_delete', {'id': media.id}) }}">
                                                <input type="hidden" name="_method" value="DELETE">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ media.id) }}">
                                                <button type="submit" class="bg-transparent border-0"><i class="fa-solid fa-trash text-danger"></i></button>
                                            </form>
                                        </div>
                                    </div>
                                {% endfor %}
                            {% endif %}
                        </div>
                    </div>

                </div>

                {{ form_start(form) }}
                <div class="figure-form">
                    <div class="form-field mb-3">{{ form_widget(form.name) }}</div>
                    <div class="form-field mb-3">{{ form_widget(form.shortDescription) }}</div>
                    <div class="form-field mb-3">{{ form_widget(form.content) }}</div>
                    <div class="form-field mb-3">{{ form_widget(form.figureGroup) }}</div>
                </div>

                <div class="d-flex justify-content-end">
                    <div class="col col-12 col-md-1">
                        <button class="btn btn-primary m-1" type="submit">Enregistrer</button>
                    </div>

                    {{ form_end(form) }}
                    <div class="col col-12 col-md-1 m-1">
                        <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#modal-figure-{{ figure.slug }}">
                            Supprimer
                        </button>
                    </div>

                    <div class="modal fade" id="modal-figure-{{ figure.slug }}" tabindex="-1" aria-labelledby="modal-figure-{{ figure.slug }}" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h1 class="modal-title fs-5" id="modal-figure-{{ figure.slug }}">Êtes-vous sûr de vouloir supprimer la figure {{ figure.name }}?</h1>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>

                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                    <form method="post" action="{{ path('app_figure_delete', {'slug': figure.slug}) }}">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ figure.slug) }}">
                                        <button type="submit" class="btn btn-danger">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            {% else %}
            {{ form_start(form) }}
            <div class="figure-form">
                <div class="form-field mb-3">{{ form_row(form.name) }}</div>
                <div class="form-field mb-3">{{ form_row(form.shortDescription) }}</div>
                <div class="form-field mb-3">{{ form_row(form.content) }}</div>
                <div class="form-field mb-3">{{ form_row(form.figureGroup) }}</div>
                <div class="form-field mb-3">{{ form_row(form.featuredMedia) }}</div>
                <div class="form-field mb-3">{{ form_row(form.media) }}</div>
            </div>

            <div class="d-flex justify-content-end">
                <div class="col col-12 col-md-1">
                    <button class="btn btn-primary m-1" type="submit">Enregistrer</button>
                </div>
            </div>

                {{ form_end(form) }}
            {% endif %}

        </div>
    </div>
{% endblock %}
