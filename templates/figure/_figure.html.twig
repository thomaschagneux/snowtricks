<div class="card card-figure">
    <div class="card-header" style="height: 200px; overflow: hidden;"> {# Hauteur fixe pour le header #}

        {% if figure.media is not empty %}
            {% set link = figure.media.first.path ? figure.media.first.path : figure.media.first.url %}
        {% endif %}
        <img src="{{ asset(link ?? '') }}" alt="image failed to load"
             class="img-fluid w-100 h-100"
             style="object-fit: cover;">
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col col-12 col-md-9 p-0">
                <a href="{{ path('app_figure_show', {'slug': figure.slug}) }}">{{ figure.name }}</a>
            </div>
            {% if app.user is not null %}
            <div class="col col-12 col-md-1 p-0 m-auto">
                <a href="{{ path('app_figure_edit', {'slug': figure.slug}) }}" class="text-dark"><i class="fa-solid fa-pen"></i></a>
            </div>

            <div class="col col-12 col-md-1 p-0 m-auto">
                <button type="button" class="bg-transparent border-0 text-danger" data-bs-toggle="modal" data-bs-target="#modal-figure-{{ figure.slug }}">
                    <i class="fa-solid fa-trash"></i>
                </button>
            </div>
            {% endif %}
            <div class="modal fade" id="modal-figure-{{ figure.slug }}" tabindex="-1" aria-labelledby="modal-figure-{{ figure.slug }}" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5" id="modal-figure-{{ figure.slug }}">Êtes-vous sûr de vouloir supprimer la figure {{ figure.name }}?</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <form method="post" action="{{ path('app_figure_delete', {'slug': figure.slug}) }}">
                                <input type="hidden" name="_method" value="DELETE">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ figure.slug) }}">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>
