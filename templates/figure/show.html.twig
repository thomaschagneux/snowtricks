{% extends 'base.html.twig' %}

{% block title %}Figure{% endblock %}

{% block body %}
<div class="card">
    <div class="card-body">

        {% if app.user %}
            <div class="position-absolute px-2 py-1 m-4 z-1 border border-black bg-light top-0 end-0 d-flex align-items-center">
                <a href="{{ path('app_figure_edit', {'slug': figure.slug}) }}" class="text-decoration-none me-2">
                    <i class="fa-solid fa-pen"></i>
                </a>
                <form method="post" action="{{ path('app_figure_delete', {'slug': figure.slug}) }}" class="d-inline">
                    <input type="hidden" name="_method" value="DELETE">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ figure.slug) }}">
                    <button type="submit" class="text-dark p-0 border-0 bg-transparent">
                        <i class="fa-solid fa-trash text-danger"></i>
                    </button>
                </form>
            </div>
        {% endif %}

        {% include 'figure/_featured_section.html.twig' %}
        {% include 'figure/_media_list_section.html.twig' %}
        {% include 'figure/_content_section.html.twig' %}
        {% include 'figure/_comment_section.html.twig' %}
    </div>
</div>
{% endblock %}
