<section id="tricks-section" class="tricks-section">
    <div class="container">
        <div class="row g-4 js-figures-container">
            {% if figures is defined and figures is not null %}
                <div class="row g-4 js-figures-container">
                    {{ include('figure/_figures_list.html.twig', {
                        figures: figures|slice(0, 15)
                    }) }}
                </div>
            {% endif %}
        </div>
    </div>

    <div class="row mt-4">
        <div class="col col-12 col-md-10 d-flex justify-content-center">
            <button class="btn btn-secondary btn-sm" id="load-more-figures">Load more</button>
        </div>
        <div class="col col-12 col-md-2 d-flex justify-content-end">
            <a href="#hero-section" class="text-dark p-3">
                <i class="fa-solid fa-arrow-up fa-2x"></i>
            </a>
        </div>
    </div>
</section>
