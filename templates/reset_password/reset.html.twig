{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6">
                <h1 class="mb-4">Réinitialiser votre mot de passe</h1>
                {{ form_start(resetForm) }}

                <div class="form-group mb-3">
                    {{ form_label(resetForm.plainPassword.first, 'Nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(resetForm.plainPassword.first, {'attr': {'class': 'form-control'}}) }}
                </div>

                <div class="form-group mb-3">
                    {{ form_label(resetForm.plainPassword.second, 'Confirmer le nouveau mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(resetForm.plainPassword.second, {'attr': {'class': 'form-control'}}) }}
                </div>

                <button type="submit" class="btn btn-primary">Réinitialiser le mot de passe</button>

                {{ form_end(resetForm) }}
            </div>
        </div>
    </div>
{% endblock %}

