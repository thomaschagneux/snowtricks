<div class="card">
    <div class="card-body">
        {{ form_start(form) }}

        {% for child in form.children %}
            <div class="row mb-3">{{ form_row(child) }}</div>
        {% endfor %}

        <button class="btn btn-primary" type="submit">Enregistrer</button>
        {{ form_end(form) }}
    </div>
</div>

